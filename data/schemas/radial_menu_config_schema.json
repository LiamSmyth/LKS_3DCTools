{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Radial Menu Configuration",
    "description": "LKS radial menu config schema version 3 — menu label + fixed pie radius.",
    "type": "object",
    "properties": {
        "version": {
            "type": "integer",
            "const": 3,
            "default": 3,
            "description": "Sequential schema version (integer). Must be 3 for this schema."
        },
        "name": {
            "type": "string",
            "description": "Optional registry / Scripts-menu display name"
        },
        "label": {
            "type": "string",
            "description": "Optional center-origin label. Empty/omitted → filename stem (or name)."
        },
        "radius": {
            "type": "integer",
            "minimum": 50,
            "maximum": 2000,
            "default": 128,
            "description": "Fixed pie radius in pixels. No auto-expand; increase manually to deoverlap."
        },
        "items": {
            "type": "array",
            "description": "Root-level menu items",
            "items": {
                "$ref": "#/definitions/menuItem"
            },
            "minItems": 1
        }
    },
    "required": [
        "items"
    ],
    "definitions": {
        "menuItem": {
            "type": "object",
            "properties": {
                "label": {
                    "type": "string",
                    "description": "Display label for the menu item"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "action",
                        "branch",
                        "list"
                    ],
                    "description": "Node kind. Soft constraint: side is only meaningful when type is list."
                },
                "side": {
                    "type": "string",
                    "enum": [
                        "left",
                        "right"
                    ],
                    "description": "List placement relative to the pie (meaningful for type=list only)"
                },
                "action": {
                    "type": "string",
                    "description": "UI command ($...), action script path, or module.function"
                },
                "icon": {
                    "type": "string",
                    "description": "Emoji or icon path (optional)"
                },
                "angle": {
                    "type": "number",
                    "description": "Explicit angle in degrees (0° = up, clockwise). Omit for auto-distribution.",
                    "minimum": 0,
                    "maximum": 360
                },
                "description": {
                    "type": "string",
                    "description": "Optional tooltip / docs text"
                },
                "children": {
                    "type": "array",
                    "description": "Child menu items (branch/list submenus)",
                    "items": {
                        "$ref": "#/definitions/menuItem"
                    }
                },
                "action_args": {
                    "type": "object",
                    "description": "Optional keyword arguments to pass to action function",
                    "additionalProperties": true
                }
            },
            "required": [
                "label",
                "type"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "action"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    },
                    "then": {
                        "required": [
                            "action"
                        ]
                    }
                }
            ]
        }
    }
}
