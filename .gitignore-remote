# Files to exclude when pushing to remote
# These files/folders ARE tracked in the local branch but NOT merged to main branch
# Format: gitignore-style patterns

# This file itself should not be on remote
.gitignore-remote

# User state folder (personal configuration and UI state)
data/state/

# Debug and log files
data/logs/

# Development-only folders
_docs/
_tools/
.example_code/
.github/
.vscode/
**/.vscode/

# Test scripts (for local development only)
_test_*.py
*_test.py

# Batch files and scripts (for local workflow)
*.bat
*.ps1

# Workspace files (personal IDE config)
*.code-workspace

# Build artifacts (if somehow tracked)
dist/
build/
*.zip
LKS_*.zip
