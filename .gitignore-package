# Package-specific exclusions for creating distribution archives
# These patterns are used by package_release.py in addition to .gitignore and .gitignore-remote
# Only include patterns NOT already covered by those files
# Format: gitignore-style patterns

# This file itself
.gitignore-package

# Git history (not needed in distribution)
.git/

# The packager script
package_release.py

# Git workflow automation scripts
git_*.py

# Assets folder (development resources not needed in distribution)
# NOTE: Keep assets/ in GitHub remote (README media); exclude only from zip/.3dcpack
assets/

# Redundant clarity: these are also in .gitignore-remote (packager loads both).
# Listed here so package dry-runs stay obvious without reading remote filters.
test/
tools/
utils/live_test/
docs/
pytest.ini
test_runner.py
